# Copy to config.env and set external PostgreSQL connection.
# Deploy scripts do NOT run SQL init automatically.

SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.31.100:5432/vectordb
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_password
SERVER_PORT=8080

# Java 21 (required on Windows if PATH default java is 8)
# JAVA_HOME=D:\jdk-21\jdk-21.0.6
